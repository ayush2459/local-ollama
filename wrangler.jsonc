{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "local-ollama-public",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  }
}
